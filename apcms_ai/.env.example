APP_ENV=development
DATA_MODE=API
LLM_MODE=GEMINI
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.5-flash
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SPRING_BOOT_BASE_URL=http://localhost:80/alpharking
CHATBOT_ME_PATH=api/chatbot/me
CHATBOT_RESERVATIONS_PATH=api/chatbot/me/reservations
CHATBOT_USAGE_PATH=api/chatbot/me/usage
CHATBOT_VEHICLES_PATH=api/chatbot/me/vehicles
CHATBOT_SAVE_PATH=api/chatbot/conversations/exchanges
MILEAGE_PATH=/api/mileage
FEES_PATH=/api/maintenance

# AI Vision: 기본적으로 실제 Boot 전송을 비활성화합니다.
PARKING_AI_BASE_URL=http://localhost:81/alpharking/admin
PARKING_AI_SEND_ENABLED=false
PARKING_AI_API_KEY=
# 카메라 --enable-http 실행은 .env 또는 운영체제 환경변수의 Boot 인증 설정을 읽습니다.
VISION_BOOT_CONTEXT_URL=http://localhost:81/alpharking/admin
AI_OCCUPANCY_API_KEY=
