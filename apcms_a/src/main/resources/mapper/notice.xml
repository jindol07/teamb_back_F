<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.alpharking.dao.notice.NoticeDao">

<insert id="add" parameterType="nidto">

    <selectKey keyProperty="noticeId" resultType="int" order="BEFORE">
        SELECT seq_notice.NEXTVAL FROM dual
    </selectKey>

    INSERT INTO NOTICE
        (notice_id
        ,writer_admin_id
        ,notice_type_code
        ,title
        ,content
        ,important_yn
        ,pinned_yn
        ,created_at
        ,updated_at)
    VALUES
        (#{noticeId}
        ,#{writerAdminId}
        ,#{noticeTypeCode}
        ,#{title}
        ,#{content}
        ,#{importantYn}
        ,#{pinnedYn}
        ,SYSDATE
        ,SYSDATE)

</insert>

<!-- 첨부파일 고유번호 생성 -->
<select id="nextAttachmentId" resultType="int">
    SELECT seq_notice_attachment.NEXTVAL FROM dual
</select>

<!-- 첨부파일 등록 -->
<insert id="addfile" parameterType="java.util.List">

    <foreach collection="list"
             item="file"
             separator=" "
             open="INSERT ALL"
             close="SELECT 1 FROM dual">

        INTO NOTICE_ATTACHMENT
            (notice_attachment_id
            ,notice_id
            ,original_name
            ,stored_name
            ,file_path
            ,file_size
            ,created_at)
        VALUES
            (#{file.noticeAttachmentId}
            ,#{file.noticeId}
            ,#{file.originalName}
            ,#{file.storedName}
            ,#{file.filePath}
            ,#{file.fileSize}
            ,SYSDATE)

    </foreach>

</insert>
</mapper>