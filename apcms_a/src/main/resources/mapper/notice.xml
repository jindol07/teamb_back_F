<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.alpharking.dao.notice.NoticeDao">

<insert id="add" parameterType="nidto">
	insert into notice
		(notice_id
		,writer_admin_id
		,notice_type_code
		,title
		,CONTENT
		,created_at
		,updated_at)
	  values(
		seq_notice.NEXTVAL
		,#{writerAdminId}
		,#{noticeTypeCode}
		,#{title}
		,#{content}
		,sysdate
		,sysdate)
</insert>

<insert id="addfile" parameterType="java.util.List">
	<!-- 현재 시퀀스 값 가져오기 -->
	<selectKey keyProperty="id" resultType="int" order="BEFORE">
		SELECT seq_notice.currVal FROM dual
	</selectKey>
	<foreach collection="list" item="file" separator=" " open="insert all"
		close="select * from dual"
	>
		INTO NOTICE_ATTACHMENT 
			(notice_attachment_id
			,notice_id
			,original_name
			,file_path
			,created_at) 
		  VALUES
		  	(seq_notice_attachment.NEXTVAL
		  	,#{id}
		  	,#{file.originalName}
		  	,#{file.filePath}
		  	,sysdate)
	</foreach>
</insert>

</mapper>